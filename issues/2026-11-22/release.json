  "light_news": [
    {
      "kind": "historical_fact",
      "title": "История «пенни-игрушек»",
      "text": "Миниатюрные игрушки из жести, известные как «пенни-игрушки», долгое время отражали повседневную жизнь и быт людей в доступной форме. Они стали предметом коллекционирования и изучения музейными экспертами.",
      "source": {
        "url": "https://apollo-magazine.com/penny-toys-tin-london-museum-ernest-king/",
        "title": "‘Penny toys’ show us all of life – in tin and in tiny form",
        "publisher": "Apollo Magazine",
        "language": "en",
        "published": "2026-11-18T15:24:46+00:00"
      }
    },
    {
      "kind": "unusual_fact",
      "title": "Развитие книги по программированию для геофизиков",
      "text": "Вышло второе издание практического руководства по применению Python для анализа данных дистанционного зондирования Земли. Книга помогает исследователям работать со спутниковыми наборами данных.",
      "source": {
        "url": "https://eos.org/editors-vox/bringing-python-solutions-to-earth-science-challenges",
        "title": "Bringing Python Solutions to Earth Science Challenges - Eos",
        "publisher": "Eos",
        "language": "en",
        "published": "2026-11-19T18:52:04+00:00"
      }
    },
    {
      "kind": "unusual_fact",
      "title": "Дальняя миграция птицы",
      "text": "Ученые впервые отследили точный маршрут миграции малого веретенника по имени Фил. Птица пролетела 6800 миль (около 10 900 километров), переместившись из Англии в Сибирь и обратно.",
      "source": {
        "url": "https://www.discoverwildlife.com/animal-facts/birds/bar-tailed-godwit-migration-tracking-phil",
        "title": "Researchers tracked a bird named Phil. He just flew a whopping 6,800 miles",
        "publisher": "Discover Wildlife",
        "language": "en",
        "published": "2026-11-19T10:17:57+00:00"
      }
    },
    {
      "kind": "unusual_fact",
      "title": "Инженерная платформа для создания скирмионов",
      "text": "Физики применили метод муарового конструирования на основе упругих волновых слоев для генерации семейств топологических структур. Такой подход позволяет создавать различные квазичастицы и управлять ими.",
      "source": {
        "url": "https://physicsworld.com/a/an-experimentally-tested-platform-for-skyrmion-engineering/",
        "title": "An experimentally tested platform for skyrmion engineering",
        "publisher": "Physics World",
        "language": "en",
        "published": "2026-11-18T08:09:36+00:00"
      }
    },
    {
      "kind": "historical_fact",
      "title": "Экспериментальное растворение алмазов",
      "text": "В 1986 году новосибирские исследователи получили округлые формы кристаллов алмаза, имитируя природные процессы растворения при высоких температурах и давлении.",
      "source": {
        "url": "https://scfh.ru/papers/almaznye-raritety-kitayskiy-fonarik/",
        "title": "Алмазные раритеты: «Китайский фонарик»",
        "publisher": "Наука из первых рук",
        "language": "ru",
        "published": "2021-12-24"
      }
    },
